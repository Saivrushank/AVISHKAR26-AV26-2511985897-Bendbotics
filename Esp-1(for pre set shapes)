      busy = false;
      btn.classList.remove('running');
      if (!isManual) {
        document.querySelectorAll('.shape-card').forEach(b => b.disabled = false);
        updateStatus('', 'READY', 'Last Completed', title, false);
      }
    });
}

function triggerStop() {
