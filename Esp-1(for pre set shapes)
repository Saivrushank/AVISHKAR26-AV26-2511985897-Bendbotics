function setMode(mode) {
  if (busy) return;
  fetch('/mode?set=' + mode).then(() => {
    isManual = (mode === 'manual');
    document.getElementById('btnAuto').classList.toggle('active', !isManual);
    document.getElementById('btnManual').classList.toggle('active', isManual);
    document.querySelectorAll('.shape-card').forEach(b => b.disabled = isManual);

    if (isManual) {
      updateStatus('manual', 'JOYSTICK', 'Remote Mapping', 'Y:Feed | X:Bend | SW:Pin', false);
    } else {
      updateStatus('', 'READY', 'Active Profile', 'Preset Geometry Mode', false);
    }
  });
}

function sendCmd(btn, cmd, title) {
  if (busy || isManual) return;
  busy = true;
  document.querySelectorAll('.shape-card').forEach(b => b.disabled = true);
  btn.classList.add('running');
  updateStatus('busy', 'RUNNING', 'Executing Cycle', title, true);

  fetch('/' + cmd)
