function updateStatus(state, text, label, val, showBar) {
  const badge = document.getElementById('statusBadge');
  badge.className = 'badge' + (state ? ' ' + state : '');
  document.getElementById('badgeText').innerText = text;
  document.getElementById('infoLabel').innerText = label;
  document.getElementById('infoValue').innerText = val;
  document.getElementById('progressTrack').classList.toggle('active', !!showBar);
