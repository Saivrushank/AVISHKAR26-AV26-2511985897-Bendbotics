// ================= HARDWARE LOCKOUT HELPERS =================
void setDriversEnabled(bool enable) {
  // DRV8825 EN pin is active-LOW: LOW = enabled, HIGH = locked off
  digitalWrite(FEEDER_EN, enable ? LOW : HIGH);
  digitalWrite(BENDER_EN, enable ? LOW : HIGH);
  if (enable) {
    delay(5); // Allow DRV8825 charge pump to stabilize before stepping
  }
}

void setServoState(bool liftUp) {
  if (!servo01.attached()) {
    servo01.attach(SERVO_PIN, 350, 2500);
  }
  servo01.writeMicroseconds(liftUp ? SERVO_UP_US : SERVO_DOWN_US);
  delay(280);

  // Detach PWM when parked DOWN so GPIO 23 stops pulsing and cannot inject STEP noise
  if (!liftUp) {
    servo01.detach();
  }
}

void checkWebStop() {
  if (millis() - lastWebCheck >= 25) {
    lastWebCheck = millis();
    server.handleClient();
  }
}

// ================= AUTO MOTION FUNCTIONS =================
void feedWire(long steps, bool reverse) {
  if (reverse) steps = -steps;
  feederStepper.moveTo(steps);
  while (feederStepper.distanceToGo() != 0 && !stopFlag) {
    feederStepper.run();
    checkWebStop();
  }
  feederStepper.setCurrentPosition(0);
}

// Standard bend sequence (Square, Hexagon, Octagon): lift -> bend out -> return home -> lower
void bendWire(long bendSteps, bool negative) {
  if (negative) bendSteps = -bendSteps;

  setServoState(true);   // Attach PWM and lift UP before bending

  benderStepper.moveTo(bendSteps);
  while (benderStepper.distanceToGo() != 0 && !stopFlag) {
    benderStepper.run();
    checkWebStop();
  }
  benderStepper.setCurrentPosition(0);

  benderStepper.moveTo(-bendSteps);
  while (benderStepper.distanceToGo() != 0 && !stopFlag) {
    benderStepper.run();
    checkWebStop();
  }
  benderStepper.setCurrentPosition(0);

  setServoState(false);  // Lower DOWN and detach PWM after bending
}

// Triangle bend sequence: bender is already at 700 -> lift UP -> bend back to home (0) -> lower DOWN
void bendTriangleWire() {
  setServoState(true);   // Lift servo UP at 700 steps

  benderStepper.moveTo(0); // Bend wire while returning to homing position (0)
  while (benderStepper.distanceToGo() != 0 && !stopFlag) {
    benderStepper.run();
    checkWebStop();
  }
  benderStepper.setCurrentPosition(0);

  setServoState(false);  // Lower servo DOWN and detach PWM before next cycle
}

// ================= SHAPES =================
void makeTriangle() {
  stopFlag = false;
  setDriversEnabled(true);
  for (int i = 0; i < 4 && !stopFlag; i++) {
    // 1. Move bender to 700 steps first (with servo DOWN) so the feed path is clear
    benderStepper.moveTo(TRIANGLE_BEND_STEPS);
    while (benderStepper.distanceToGo() != 0 && !stopFlag) {
      benderStepper.run();
      checkWebStop();
    }

    // 2. Feed wire while bender is parked at 700 steps
    if (!stopFlag) {
      feedWire(300, true);
    }

    // 3. Lift servo UP and bend wire back to homing position (0)
    if (!stopFlag) {
      bendTriangleWire();
    }
  }
  setDriversEnabled(false);
}

void makeSquare() {
  stopFlag = false;
  setDriversEnabled(true);
  for (int i = 0; i < 5 && !stopFlag; i++) {
    feedWire(420, true);
    bendWire(SQUARE_BEND_STEPS, false);
  }
  setDriversEnabled(false);
}

void makeHexagon() {
  stopFlag = false;
  setDriversEnabled(true);
  for (int i = 0; i < 7 && !stopFlag; i++) {
    feedWire(220, true);
    bendWire(HEXAGON_BEND_STEPS, false);
  }
  setDriversEnabled(false);
}

void makeOctagon() {
  stopFlag = false;
  setDriversEnabled(true);
  for (int i = 0; i < 9 && !stopFlag; i++) {
    feedWire(220, true);
    bendWire(OCTAGON_BEND_STEPS, false);
  }
  setDriversEnabled(false);
}

// ================= UDP JOYSTICK HANDLER =================
void handleJoystickUDP() {
  int packetSize = udp.parsePacket();
  if (packetSize > 0) {
    char packet[32];
    int len = udp.read(packet, sizeof(packet) - 1);
    if (len > 0) packet[len] = '\0';

    int fSpd = 0, bSpd = 0, sToggle = 0;
    if (sscanf(packet, "%d,%d,%d", &fSpd, &bSpd, &sToggle) == 3) {
      lastPacketTime = millis();
      if (manualMode) {
        manualFeedSpeed = constrain(fSpd, -900, 900);
        manualBendSpeed = constrain(bSpd, -900, 900);

        if (sToggle == 1) {
          manualServoUp = !manualServoUp;
          setServoState(manualServoUp);
        }
      }
    }
  }

  // Safety fail-safe: stop motors if wireless signal drops for > 300ms
  if (manualMode && (millis() - lastPacketTime > 300)) {
    manualFeedSpeed = 0;
    manualBendSpeed = 0;
  }
}

// ================= SETUP =================
void setup() {
  Serial.begin(115200);

  // Lock both stepper drivers OFF immediately at boot
  pinMode(FEEDER_EN, OUTPUT);
  pinMode(BENDER_EN, OUTPUT);
  setDriversEnabled(false);

  // Park servo down and detach PWM
  setServoState(false);

  feederStepper.setMinPulseWidth(5);
  feederStepper.setMaxSpeed(900);
  feederStepper.setAcceleration(400);
  feederStepper.setCurrentPosition(0);

  benderStepper.setMinPulseWidth(5);
  benderStepper.setMaxSpeed(900);
  benderStepper.setAcceleration(400);
  benderStepper.setCurrentPosition(0);

  // WIFI
  WiFi.begin(ssid, password);
  Serial.print("Connecting");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("\nConnected!");
  Serial.print("ESP32 IP Address: ");
  Serial.println(WiFi.localIP());

  if (MDNS.begin("wirebender")) {
    Serial.println("mDNS ready: http://wirebender.local");
  }

  udp.begin(UDP_PORT);

  // WEB ROUTES
  server.on("/", []() {
    server.send(200, "text/html", MAIN_page);
  });

  server.on("/mode", []() {
    String m = server.arg("set");
    stopFlag = true;
    manualFeedSpeed = 0;
    manualBendSpeed = 0;
    lastFeedMove = 0;
    lastBendMove = 0;
    feederStepper.setCurrentPosition(0);
    benderStepper.setCurrentPosition(0);
    manualServoUp = false;
    setServoState(false);

    if (m == "manual") {
      manualMode = true;
      setDriversEnabled(false); // Stay locked off until a joystick actually moves
    } else {
      manualMode = false;
      setDriversEnabled(false);
    }
    server.send(200, "text/plain", "OK");
  });

  server.on("/triangle", []() { if (!manualMode) makeTriangle(); server.send(200); });
  server.on("/square", []()   { if (!manualMode) makeSquare();   server.send(200); });
  server.on("/hexagon", []()  { if (!manualMode) makeHexagon();  server.send(200); });
  server.on("/octagon", []()  { if (!manualMode) makeOctagon();  server.send(200); });

  server.on("/stop", []() {
    stopFlag = true;
    manualFeedSpeed = 0;
    manualBendSpeed = 0;
    lastFeedMove = 0;
    lastBendMove = 0;
    feederStepper.stop();
    benderStepper.stop();
    setDriversEnabled(false);
    manualServoUp = false;
    setServoState(false);
    server.send(200);
  });

  server.begin();
}

// ================= LOOP =================
void loop() {
  server.handleClient();
  handleJoystickUDP();

  if (manualMode) {
    unsigned long now = millis();

    // Feeder: energize only while Joystick 1 moves, lock off 250ms after release
    if (manualFeedSpeed != 0) {
      if (digitalRead(FEEDER_EN) == HIGH) {
        digitalWrite(FEEDER_EN, LOW);
        delayMicroseconds(500);
      }
      lastFeedMove = now;
      feederStepper.setSpeed(manualFeedSpeed);
      feederStepper.runSpeed();
    } else if (now - lastFeedMove > 250) {
      digitalWrite(FEEDER_EN, HIGH);
    }

    // Bender: energize only while Joystick 2 moves, lock off 250ms after release
    if (manualBendSpeed != 0) {
      if (digitalRead(BENDER_EN) == HIGH) {
        digitalWrite(BENDER_EN, LOW);
        delayMicroseconds(500);
      }
      lastBendMove = now;
      benderStepper.setSpeed(manualBendSpeed);
      benderStepper.runSpeed();
    } else if (now - lastBendMove > 250) {
      digitalWrite(BENDER_EN, HIGH);
    }
  }
}
